VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_SITE_VERIFICATION=google-site-verification-token
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEAD_REPLY_FROM=3D-WINDT <noreply@3d-windt.de>
LEAD_ALERT_FROM=3D-WINDT Alert <alerts@3d-windt.de>
LEAD_SALES_EMAIL=support@3d-windt.de

# --- Stripe payments (Netlify Functions create-checkout, payment-link, stripe-webhook) ---
# Tax treatment, no default: "kleinunternehmer" (no VAT, § 19 UStG notice) or
# "regelbesteuerung" (19 % via STRIPE_TAX_RATE_19). Decide with the tax advisor.
# Unset or invalid = checkout is refused.
TAX_MODE=
# Stripe secret key (test first: sk_test_..., later sk_live_...). A restricted key (rk_...) works too.
STRIPE_SECRET_KEY=
# Price ID of "Ersatzteil- und Vorrichtungs-Check vor Ort", 490.00 EUR, one-time.
STRIPE_PRICE_ERSATZTEIL_CHECK=
# Only for TAX_MODE=regelbesteuerung: tax rate "USt. 19 %", exclusive.
STRIPE_TAX_RATE_19=
# Signing secret of the webhook endpoint https://3d-windt.de/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# HMAC key for signed quote pay links (>= 32 chars, e.g. `openssl rand -base64 48`).
# Must be identical locally (scripts/payment-link.mjs) and in Netlify.
PAYMENT_LINK_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
# Netlify sets URL automatically on deploy; only needed for local `netlify dev`.
URL=http://localhost:8888
