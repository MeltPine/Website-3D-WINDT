# Build-time variables for Vite (read by `npm run build`; set them in the
# Cloudflare Pages project as plain build variables).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_SITE_VERIFICATION=google-site-verification-token

# Runtime configuration of the Pages Functions (Resend, uploads, Stripe) is NOT
# read from .env: locally it lives in .dev.vars (template: .dev.vars.example),
# in production in Cloudflare Pages secrets. See docs/cloudflare-migration.md.
#
# The quote-link CLI reads PAYMENT_LINK_SECRET from the shell environment:
#   PAYMENT_LINK_SECRET=... node scripts/payment-link.mjs --help
